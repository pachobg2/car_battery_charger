// Rename this file to config.h and adjust if needed.
// config.h holds this device's full configuration -- identity and
// hardware settings. No WiFi/MQTT/cloud credentials here: this is a
// standalone device, no networking. Keep it out of git (add it to
// .gitignore) in case you ever add something sensitive to it.
#pragma once

// ------------------------------------------------------------------
// Device identity
// ------------------------------------------------------------------
static const char* DEVICE_ID        = "car_battery_charger1"; // NVS (Preferences) namespace
static const char* FIRMWARE_VERSION = "1.4.0";

// ------------------------------------------------------------------
// Hardware -- I2C bus (INA219 current/voltage sensor + SH1106 OLED)
// ------------------------------------------------------------------
static const int I2C_SDA_PIN        = 4; // matches temp_humidity_sensor_v4's I2C pins
static const int I2C_SCL_PIN        = 5;
static const uint8_t INA219_I2C_ADDR = 0x40;
static const uint8_t OLED_I2C_ADDR   = 0x3C;

// ------------------------------------------------------------------
// INA219 custom shunt calibration -- 0.01 ohm / 25W shunt resistor
// (swapped in place of the breakout's stock 0.1 ohm shunt) for range up
// to ~10A. The Adafruit_INA219 library only ships fixed presets
// (setCalibration_32V2A/32V1A/16V400mA) tuned for a 0.1 ohm shunt, so its
// getCurrent_mA() would silently use the wrong scale factor here -- the
// sketch instead writes the calibration register itself and reads the
// raw current register directly, scaled by INA219_CURRENT_LSB_A below.
//
// Derived per the INA219 datasheet's calibration procedure, for
// Max_Expected_Current = 10A and R_SHUNT = 0.01 ohm:
//   Current_LSB = 10A / 32767 = 305.2 uA/bit, rounded up to a clean
//                 400 uA/bit for headroom to ~13.1A before the current
//                 register overflows.
//   Calibration = trunc(0.04096 / (Current_LSB * R_SHUNT))
//               = trunc(0.04096 / (0.0004 * 0.01)) = 10240
// Shunt voltage at 10A = 10A * 0.01ohm = 100mV, comfortably inside the
// INA219's default +-320mV PGA range -- no gain change needed.
//
// If you change the shunt resistor or the current range you want,
// recompute BOTH constants below together -- they only make sense as a
// matched pair.
static const float INA219_CURRENT_LSB_A = 0.0004f; // 400uA/bit
static const uint16_t INA219_CALIBRATION = 10240;

// ------------------------------------------------------------------
// Supply-rail voltage divider -- a SECOND, independent voltage sense,
// needed because of how this design measures battery voltage. Read this
// even if you skip other comments.
//
// The MOSFET bank sits in the battery's NEGATIVE return leg (needed so
// their sources can be gate-driven straight from a ground-referenced
// ESP32 GPIO -- see the gate-drive section below). That means the node
// between the battery's negative terminal and the MOSFETs (call it the
// "return rail") floats: as the battery charges from ~11.5V to ~14.6V,
// the return rail's voltage relative to true system ground actually
// FALLS from ~14.5V to ~11.4V (it's SUPPLY_VOLTAGE minus battery
// voltage). The INA219's own bus-voltage reading is only ever relative
// to its own GND pin -- which must be tied to true system ground for
// I2C with the ESP32 to work at all -- so ina219.getBusVoltage_V() reads
// THIS RETURN RAIL, not the battery's actual terminal voltage.
//
// Rather than trust a possibly-sagging/unregulated 26V supply as a fixed
// constant to back-calculate from, this sketch measures the supply rail
// directly with a second resistor divider into an ESP32 ADC pin, and
// computes: battery_voltage = supply_rail_measured - ina219_bus_reading.
// Both terms are ground-referenced measurements, so the subtraction is
// robust even if your supply sags under load or isn't exactly 26V.
//
// Divider: SUPPLY+ --[110k]-- ADC pin --[10k]-- GND, plus a 100nF cap
// from the ADC pin to GND to quiet the reading. At 26V this puts ~2.17V
// on the ADC pin (comfortably inside the ESP32 ADC's accurate range);
// at 30V, ~2.5V -- headroom if your supply runs a bit high.
// SUPPLY_DIVIDER_RATIO = (110k + 10k) / 10k = 12.0 -- multiply the ADC's
// calibrated millivolt reading by this to get the actual rail voltage.
// This is a NOMINAL value from ideal resistor values; real resistors
// have tolerance, so calibrate it against a multimeter reading on the
// actual supply rail and adjust this constant until the Serial Monitor's
// reported supply voltage matches.
static const int SUPPLY_VOLTAGE_DIVIDER_PIN = 0; // ADC1_CH0
static const float SUPPLY_DIVIDER_RATIO = 12.0f;
static const uint8_t SUPPLY_ADC_SAMPLES = 16; // averaged per reading, to quiet ADC noise

// ------------------------------------------------------------------
// Hardware -- rotary encoder with push button
// ------------------------------------------------------------------
// A/B need to be interrupt-capable (any GPIO on ESP32-C3 qualifies). Wire
// the encoder's common pin to GND and enable internal pull-ups (done in
// firmware) rather than relying on the module having its own.
static const int ENCODER_A_PIN  = 6;
static const int ENCODER_B_PIN  = 7;
static const int ENCODER_SW_PIN = 3;
// Most cheap mechanical encoders produce 4 A/B edges per detent (click).
// If a single click of your encoder moves the value by 4 steps instead of
// 1, or does nothing, try 1 or 2 here. (The decoder itself is bounce-
// rejecting -- see onEncoderChange() in the sketch -- so this is purely
// about how many electrical edges your specific encoder produces per
// mechanical click, not a debounce tuning knob.)
static const uint8_t ENCODER_EDGES_PER_DETENT = 4;
// Which physical rotation direction increases a value (manual current,
// capacity scroll) is determined by which of A/B you wired where --
// there's no universal answer, so it's a flag instead of a fixed
// assumption. Flip this if turning clockwise decreases instead of
// increases (or swap the A/B wires at the encoder instead, which has
// the same effect).
static const bool ENCODER_REVERSED = true;

// ------------------------------------------------------------------
// Hardware -- onboard WS2812 status LED (matches smart_switch's GPIO10
// convention on these ESP32-C3 boards). Set STATUS_LED_ENABLED to false
// if your specific ESP32-C3-Zero variant doesn't have one on this pin.
// ------------------------------------------------------------------
static const bool STATUS_LED_ENABLED = true;
static const int STATUS_LED_PIN      = 10;
static const uint8_t STATUS_LED_BRIGHTNESS = 40; // 0-255, keep low -- it's a status dot, not a room light

// ------------------------------------------------------------------
// Hardware -- piezo buzzer (passive, driven via the ESP32 core's
// tone()/noTone(), which manages its own LEDC channel internally --
// no conflict with the MOSFET gate's own ledcAttach() on a different
// pin). A passive piezo can be driven straight off a GPIO through a
// small series resistor (100R, protects the pin from the piezo's
// capacitive inrush); for louder output, drive it through a small NPN
// transistor (base resistor from the GPIO, piezo + resistor from
// 3V3/5V to collector, emitter to GND) instead -- optional, not
// required for a basic audible alert.
//
// Pin choice: every non-strapping GPIO is already spoken for by this
// design (see the pins table in the README), so this defaults to
// GPIO8 -- a strapping pin, but only sampled at boot/reset, and this
// sketch never drives it until well after boot. Two things to verify
// before wiring: (1) that nothing else pulls GPIO8 during reset (a
// bare piezo, with no extra pull resistor of your own, shouldn't), and
// (2) that your specific ESP32-C3-Zero variant doesn't already use
// GPIO8 for something else (a few ESP32-C3 dev boards put a second
// onboard LED there) -- check its silkscreen/pinout diagram. If it's
// taken, GPIO2 is the other free strapping pin; avoid GPIO9, since
// that's the BOOT button on most of these boards.
// ------------------------------------------------------------------
static const bool BUZZER_ENABLED = true;
static const int BUZZER_PIN      = 8;
// Tone sequences: parallel frequency/duration arrays, one entry per
// step, stepped through in order by updateBuzzer() in the sketch. A
// frequency of 0 is a silent gap (needed to make two notes read as
// separate beeps instead of one continuous tone).
static const uint16_t BUZZER_START_FREQ_HZ[] = {1000, 1500};                // charging started: short rising chirp
static const uint16_t BUZZER_START_DUR_MS[]  = {90, 120};
static const uint16_t BUZZER_DONE_FREQ_HZ[]  = {1500, 0, 1800, 0, 2200};    // charge complete: rising triple beep
static const uint16_t BUZZER_DONE_DUR_MS[]   = {110, 60, 110, 60, 160};
static const uint16_t BUZZER_FAULT_FREQ_HZ[] = {400, 0, 400, 0, 400};       // fault/refused to start: low triple beep
static const uint16_t BUZZER_FAULT_DUR_MS[]  = {180, 100, 180, 100, 180};
static const uint16_t BUZZER_STOP_FREQ_HZ[]  = {700};                       // manual stop: single neutral click
static const uint16_t BUZZER_STOP_DUR_MS[]   = {80};

// ------------------------------------------------------------------
// Hardware -- MOSFET bank, run in its LINEAR region as a variable
// resistor (not switched on/off) -- there is no inductor/buck stage in
// this design. FOUR IRL540Ns in parallel (Q1-Q4), sharing the load, to
// spread out the heat -- see the thermal comment on MAX_CHARGE_CURRENT_A
// below for why one alone can't handle the 10A ceiling.
//
// Gate bias (shared by all four -- purely analog, one GPIO drives the
// whole bank, no firmware changes needed for the parallel MOSFETs):
//
//   MOSFET_GATE_PIN --[2.2k]--+-------------------------- BIAS node
//                             |
//                         [1uF cap]
//                             |
//                            GND
//   BIAS --[10k pulldown]-- GND
//   BIAS --[100R]-- Q1 gate     BIAS --[100R]-- Q2 gate
//   BIAS --[100R]-- Q3 gate     BIAS --[100R]-- Q4 gate
//
// The 2.2k/1uF forms an RC low-pass (~72Hz cutoff) that turns the fast
// GATE_PWM_FREQ_HZ PWM into a smooth analog gate bias; the 10k pulldown
// guarantees BIAS (and every gate) sits at 0V while the ESP32 is
// booting/this pin is floating, before setup() ever configures it. Each
// MOSFET gets its OWN 100R gate-stopper resistor off the shared BIAS
// node -- paralleled MOSFET gates tied straight together are prone to
// high-frequency parasitic oscillation; individual stoppers damp that.
//
// Current sharing -- IMPORTANT, don't skip this: MOSFETs run in their
// LINEAR region do NOT share current evenly on their own the way they
// would as fully-saturated switches. A device that happens to run
// slightly hotter conducts MORE current at the same Vgs (its threshold
// voltage drops with temperature), which makes it run hotter still --
// a positive feedback loop that can destroy one MOSFET while its
// neighbors idle (thermal runaway). Each MOSFET's source therefore gets
// its own small ballast resistor before the common return:
//
//   Q1 source --[0.22R 5W]--+
//   Q2 source --[0.22R 5W]--+-- common return -- MAIN_SHUNT -- GND
//   Q3 source --[0.22R 5W]--+
//   Q4 source --[0.22R 5W]--+
//
// A device pulling more than its share drops more voltage across its
// own ballast resistor, which reduces ITS OWN effective Vgs (gate is
// common, source rises) and throttles it back down -- self-correcting
// negative feedback. At ~2.5A/device (10A / 4), 0.22R drops ~0.55V
// (enough for real balancing authority) and dissipates ~1.4W (use 5W
// resistors for margin). Use MOSFETs from the same batch if you can --
// matched Vgs(th) means less work for the ballast resistors to do.
//
// THERMAL WARNING: total dissipation across the whole bank is still
// (supply_voltage - battery_voltage) * charge_current, same physics as
// a single device -- paralleling only SPREADS that heat across more
// packages, it doesn't reduce the total. See MAX_CHARGE_CURRENT_A below.
// ------------------------------------------------------------------
static const int MOSFET_GATE_PIN          = 1;
static const uint32_t GATE_PWM_FREQ_HZ    = 20000; // fast carrier, smoothed by the RC filter above
static const uint8_t  GATE_PWM_RESOLUTION = 10;    // 0-1023 steps
static const uint16_t GATE_PWM_MAX_DUTY   = (1 << GATE_PWM_RESOLUTION) - 1;

// ------------------------------------------------------------------
// Charge algorithm -- flooded/AGM lead-acid, 3-stage (bulk -> absorption
// -> done). All voltages are at the battery terminals (the computed
// battery_voltage = supply_rail_measured - ina219_bus_reading described
// above, not the raw INA219 bus reading), at typical ambient temperature
// -- no temperature compensation.
// ------------------------------------------------------------------
static const float SUPPLY_VOLTAGE       = 26.0f; // nominal only -- the real supply rail is measured, see above
static const float BULK_TARGET_VOLTAGE  = 14.4f; // bulk ends, absorption starts here
static const float ABSORPTION_VOLTAGE   = 14.6f; // held constant during absorption
static const float OVER_VOLTAGE_CUTOFF  = 15.0f; // immediate hard stop, any stage
static const float NO_BATTERY_VOLTAGE_THRESHOLD = 8.0f; // below this at start = nothing plausible connected

// Bulk-stage current as a fraction of capacity for "easy mode" (0.1 = C/10,
// a conservative slow-charge rate safe for old/unknown-condition batteries).
// Deliberately matches the 100Ah preset to exactly 10A -- the reason
// MAX_CHARGE_CURRENT_A below was raised to 10A in the first place.
static const float BULK_CURRENT_FRACTION_OF_CAPACITY = 0.10f;

// Hard ceiling on charge current regardless of capacity/manual setting.
//
// Sensor-side, this is a non-issue: the custom calibration above reads
// accurately to ~13A. The REAL ceiling is thermal. At a 26V supply, a
// battery sitting at its lowest resting voltage (~11.5V) is exactly when
// charge current -- and therefore MOSFET voltage drop -- is highest:
// (26 - 11.5) * 10 = ~145W total, continuously, split across the 4
// paralleled MOSFETs in the bank above -- about 36W each in the worst
// case (start of a bulk charge on a deeply discharged battery, which is
// exactly when easy-mode picks the highest current). 36W per TO-220 is
// realistic on a real heatsink with airflow, but it's not casual --
// watch case temperature on first use anywhere near this ceiling, and
// back this off (or add more parallel MOSFETs) if it's climbing past
// what your cooling can hold in steady state. If you build with fewer
// than 4 MOSFETs, lower this proportionally.
static const float MAX_CHARGE_CURRENT_A = 10.0f;

// Absorption ends ("done") once current has stayed below this fraction of
// the selected capacity for MIN_TERMINATION_DWELL_MS continuously.
static const float TERMINATION_CURRENT_FRACTION  = 0.03f; // 3% of capacity
static const uint32_t MIN_TERMINATION_DWELL_MS   = 5UL * 60 * 1000UL;   // 5 min
static const uint32_t MIN_ABSORPTION_MS          = 20UL * 60 * 1000UL;  // don't allow "done" before this
static const uint32_t MAX_CHARGE_DURATION_MS     = 14UL * 3600UL * 1000UL; // 14h absolute safety timeout
// Independent hard-current-cutoff safety net (fires even if the control
// loop itself misbehaves) -- current above MAX_CHARGE_CURRENT_A times this
// factor, sustained, is treated as a fault (short/wiring problem), not a
// control error to correct.
static const float OVER_CURRENT_FAULT_FACTOR     = 1.25f;
static const uint32_t OVER_CURRENT_FAULT_DWELL_MS = 1000UL;

// Rough charge-efficiency factor applied to coulomb counting for the
// state-of-charge estimate and ETA (lead-acid isn't 100% efficient --
// some delivered current becomes heat/gassing, not stored charge).
static const float CHARGE_EFFICIENCY = 0.85f;

// ------------------------------------------------------------------
// Easy-mode battery capacity presets (Ah) -- rotary-encoder selectable
// ------------------------------------------------------------------
static const uint16_t CAPACITY_PRESETS_AH[] = {44, 50, 55, 60, 65, 70, 80, 85, 90, 100};
static const uint8_t CAPACITY_PRESETS_COUNT = sizeof(CAPACITY_PRESETS_AH) / sizeof(CAPACITY_PRESETS_AH[0]);
static const uint8_t DEFAULT_CAPACITY_PRESET_INDEX = 3; // 60Ah, a common car-battery size

// ------------------------------------------------------------------
// Manual-mode current selection (encoder-adjustable when not using a
// capacity preset)
// ------------------------------------------------------------------
static const float MANUAL_CURRENT_STEP_A = 0.1f;
static const float MANUAL_CURRENT_MIN_A  = 0.2f;
static const float DEFAULT_MANUAL_CURRENT_A = 1.0f;

// ------------------------------------------------------------------
// UI timing
// ------------------------------------------------------------------
static const uint32_t LONG_PRESS_MS       = 1500;
static const uint32_t BUTTON_DEBOUNCE_MS  = 30;

// ------------------------------------------------------------------
// Control loop
// ------------------------------------------------------------------
static const uint32_t CONTROL_LOOP_INTERVAL_MS   = 100;  // current/voltage regulation update rate
static const uint32_t DISPLAY_UPDATE_INTERVAL_MS = 250;
static const uint32_t SOFT_START_RAMP_MS         = 3000; // ramp gate duty from 0 over this long on every (re)start
// PI control gains on gate PWM duty (0-GATE_PWM_MAX_DUTY) vs the current
// error (bulk stage) or voltage error (absorption stage). These are
// starting points, not calibrated for your exact RC filter/MOSFET sample
// -- if current oscillates, lower Kp; if it settles too slowly, raise Ki
// a little. Tune with the Serial Monitor open (the control loop logs
// error/duty every update).
static const float BULK_KP    = 80.0f;  // duty counts per amp of error
static const float BULK_KI    = 15.0f;  // duty counts per amp-second of accumulated error
static const float ABS_KP     = 40.0f;  // duty counts per volt of error
static const float ABS_KI     = 8.0f;   // duty counts per volt-second of accumulated error
static const float PI_INTEGRAL_CLAMP = 400.0f; // anti-windup clamp on the integral term (duty counts)
